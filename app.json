{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "com.shelly.blu_remote",
  "version": "1.0.0",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local",
    "cloud"
  ],
  "name": {
    "en": "Shelly BLU Remote ZB"
  },
  "description": {
    "en": "Add support for the Shelly BLU Remote Control ZB"
  },
  "category": [
    "appliances"
  ],
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Dimitar Marinov",
    "email": "triochi@gmail.com"
  },
  "flow": {
    "triggers": [
      {
        "id": "remote_on",
        "title": {
          "en": "On command was received"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=remote_control"
          }
        ]
      },
      {
        "id": "remote_off",
        "title": {
          "en": "Off command was received"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=remote_control"
          }
        ]
      },
      {
        "id": "remote_toggle",
        "title": {
          "en": "Toggle command was received"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=remote_control"
          }
        ]
      },
      {
        "id": "remote_level",
        "title": {
          "en": "Level command was received"
        },
        "tokens": [
          {
            "name": "level",
            "type": "number",
            "title": {
              "en": "Level"
            },
            "example": 0.75
          },
          {
            "name": "level_raw",
            "type": "number",
            "title": {
              "en": "Level (raw)"
            },
            "example": 191
          },
          {
            "name": "transition_time",
            "type": "number",
            "title": {
              "en": "Transition time (s)"
            },
            "example": 1
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=remote_control"
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "id": "remote_control",
      "name": {
        "en": "BLU Remote Control ZB"
      },
      "platforms": [
        "local",
        "cloud"
      ],
      "connectivity": [
        "zigbee"
      ],
      "class": "remote",
      "capabilities": [
        "alarm_battery"
      ],
      "energy": {
        "batteries": [
          "CR2032",
          "CR2032"
        ]
      },
      "zigbee": {
        "manufacturerName": "Shelly",
        "productId": [
          "BLU Remote Control ZB"
        ],
        "endpoints": {
          "1": {
            "clusters": [
              0,
              1,
              3,
              32
            ],
            "bindings": [
              6,
              8
            ]
          }
        },
        "learnmode": {
          "image": "/drivers/remote_control/assets/learnmode.svg",
          "instruction": {
            "en": "Press and hold the center button on the BLU Remote for 10 seconds until the LED starts blinking rapidly, then release."
          }
        }
      },
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Group Addresses"
          },
          "children": [
            {
              "id": "group_address_1",
              "type": "number",
              "label": {
                "en": "Group Address 1"
              },
              "hint": {
                "en": "Zigbee group address for button group 1 (1–65534)."
              },
              "value": 1,
              "attr": {
                "min": 1,
                "max": 65534,
                "step": 1
              }
            },
            {
              "id": "group_address_2",
              "type": "number",
              "label": {
                "en": "Group Address 2"
              },
              "hint": {
                "en": "Zigbee group address for button group 2 (1–65534)."
              },
              "value": 2,
              "attr": {
                "min": 1,
                "max": 65534,
                "step": 1
              }
            },
            {
              "id": "group_address_3",
              "type": "number",
              "label": {
                "en": "Group Address 3"
              },
              "hint": {
                "en": "Zigbee group address for button group 3 (1–65534)."
              },
              "value": 3,
              "attr": {
                "min": 1,
                "max": 65534,
                "step": 1
              }
            },
            {
              "id": "group_address_4",
              "type": "number",
              "label": {
                "en": "Group Address 4"
              },
              "hint": {
                "en": "Zigbee group address for button group 4 (1–65534)."
              },
              "value": 4,
              "attr": {
                "min": 1,
                "max": 65534,
                "step": 1
              }
            }
          ]
        }
      ],
      "images": {
        "large": "/drivers/remote_control/assets/images/large.png",
        "small": "/drivers/remote_control/assets/images/small.png",
        "xlarge": "/drivers/remote_control/assets/images/xlarge.png"
      }
    }
  ]
}